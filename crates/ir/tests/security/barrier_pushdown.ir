; Below the barrier only leakproof predicates may run: the comparison moves
; down to the scan, LIKE (which can raise an error) stays above.
(policies (permit (read) Doc (== resource.owner principal)))
(plan (project (filter (get docs :as d) (and (> d.secret 3) (like d.title "a%"))) d.id))
;; secured
(plan :schema-version 3
  (project :bind 2
    (filter
      (policy-filter (get (tid 203) :as d :bind 1) (try (= #1.1 1) false))
      (and (coalesce (lift (> #1.4 3)) false) (like #1.3 "a%")))
    (as #1.0 id)))
;; optimized
(plan :schema-version 3
  (project :bind 2
    (filter
      (policy-filter
        (filter
          (get (tid 203) :as d :bind 1)
          (coalesce (lift (> #1.4 3)) false))
        (try (= #1.1 1) false))
      (like #1.3 "a%"))
    (as #1.0 id)))
