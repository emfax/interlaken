; The fixture catalog for security tests: users in groups, documents in
; nested folders, and an ungoverned notes table.
(catalog :schema-version 3
  (builtins)
  (table users :id 200
    (column id int8) (column name text) (column dept (option text)) (column level (option int8))
    (column manager_id (option int8))
    (primary-key id))
  (table groups :id 201 (column id int8) (column name text) (primary-key id))
  (table folders :id 202 (column id int8) (column name text) (primary-key id))
  (table docs :id 203
    (column id int8) (column owner_id int8) (column folder_id (option int8))
    (column title text) (column secret (option int8)) (column tags (option (array text)))
    (primary-key id))
  (table user_groups :id 204 (column member int8) (column grp int8) (primary-key member grp))
  (table user_groups_closure :id 205
    (column member int8) (column grp int8) (column paths int8)
    (primary-key member grp))
  (table folder_parents :id 206 (column child int8) (column parent int8) (primary-key child parent))
  (table folder_closure :id 207
    (column descendant int8) (column ancestor int8) (column paths int8)
    (primary-key descendant ancestor))
  (table doc_folders :id 208 (column doc int8) (column folder int8) (primary-key doc folder))
  (table doc_folders_closure :id 209
    (column doc int8) (column folder int8) (column paths int8)
    (primary-key doc folder))
  (table notes :id 210 (column id int8) (column body (option text)) (primary-key id))
  (entity User :table users :key id (attr name) (attr dept) (attr level)
    (attr manager manager_id :references User))
  (entity Group :table groups :key id (attr name))
  (entity Folder :table folders :key id (attr name))
  (entity Doc :table docs :key id
    (attr owner owner_id :references User) (attr folder folder_id :references Folder)
    (attr title) (attr secret) (attr tags))
  (membership User Group :edges user_groups (member grp) :closure user_groups_closure (member grp paths))
  (membership Folder Folder :edges folder_parents (child parent) :closure folder_closure (descendant ancestor paths))
  (membership Doc Folder :edges doc_folders (doc folder) :closure doc_folders_closure (doc folder paths)))
