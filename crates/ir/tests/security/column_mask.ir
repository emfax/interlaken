; A column policy that depends on the row and declares a mask (ADR-0032):
; the governed get is wrapped in a projection that keeps its binding and
; shows the owner's title, or mask_last4 of it, through policy_mask.
(policies
  (permit (read) Doc true)
  (permit (read) Doc (== resource.owner.dept principal.dept) :column title :mask mask_last4))
(plan (project (filter (get docs :as d) (like d.title "a%")) d.id d.title))
;; secured
(plan :schema-version 3
  (project :bind 5
    (filter
      (project :bind 4
        (apply single
          (get (tid 203) :as d :bind 1)
          (project :bind 3
            (filter (get (tid 200) :as |sec$1| :bind 2) (= #2.0 #1.1))
            (as #2.2 dept)))
        (as #1.0 id)
        (as #1.1 owner_id)
        (as #1.2 folder_id)
        (as
          (call
            (fid 72)
            (try (= (call (fid 59) #3.0) "eng") false)
            #1.3
            (call (fid 66) #1.3))
          title)
        (as #1.4 secret)
        (as #1.5 tags))
      (like #4.3 "a%"))
    (as #4.0 id)
    (as #4.3 title)))
;; optimized
(plan :schema-version 3
  (project :bind 5
    (filter
      (project :bind 4
        (join left
          (get (tid 203) :as d :bind 1)
          (project :bind 3
            (get (tid 200) :as |sec$1| :bind 2)
            (as #2.2 dept)
            #2.0)
          (= #3.1 #1.1))
        (as #1.0 id)
        (as
          (call
            (fid 72)
            (try (= (call (fid 59) #3.0) "eng") false)
            #1.3
            (call (fid 66) #1.3))
          title))
      (like #4.1 "a%"))
    (as #4.0 id)
    (as #4.1 title)))
