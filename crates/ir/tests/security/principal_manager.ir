; Policies reading an entity beyond the principal (ADR-0032): ann's manager
; (bob) is known before the query runs, so his department is substituted.
(policies (permit (read) Doc (== resource.owner.dept principal.manager.dept)))
(plan (project (get docs :as d) d.id))
;; secured
(plan :schema-version 3
  (project :bind 4
    (policy-filter
      (apply single
        (get (tid 203) :as d :bind 1)
        (project :bind 3
          (filter (get (tid 200) :as |sec$1| :bind 2) (= #2.0 #1.1))
          (as #2.2 dept)))
      (try (= (call (fid 59) #3.0) "ops") false))
    (as #1.0 id)))
;; optimized
(plan :schema-version 3
  (project :bind 4
    (policy-filter
      (join left
        (get (tid 203) :as d :bind 1)
        (project :bind 3
          (get (tid 200) :as |sec$1| :bind 2)
          (as #2.2 dept)
          #2.0)
        (= #3.1 #1.1))
      (try (= (call (fid 59) #3.0) "ops") false))
    (as #1.0 id)))
