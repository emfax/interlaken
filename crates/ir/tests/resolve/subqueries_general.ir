; Elsewhere: a scalar subquery becomes a single apply, EXISTS a left apply
; of a marker row, and NOT IN / ALL an aggregate computing three-valued logic.
(plan
  (project
    (filter
      (get users :as u)
      (or (not (in u.id (project (get audit :as a) a.user_id))) (> u.karma 100)))
    u.name
    (as
      (scalar (aggregate (filter (get posts :as p) (= p.author_id u.id)) (keys) (aggs (agg max p.created_at))))
      last_post)
    (as (exists (filter (get follows :as f) (= f.followee_id u.id))) followed)
    (as (all >= u.karma (project (get posts :as q) q.likes)) top)))
;; resolved
(plan :schema-version 7
  (project :bind 12
    (apply single
      (apply left
        (apply single
          (filter
            (apply single
              (get (tid 100) :as u :bind 1)
              (aggregate :bind 4
                (project :bind 3
                  (get (tid 103) :as a :bind 2)
                  (as #2.1 user_id))
                (keys)
                (aggs
                  (as (agg (fid 53) (lift (= #1.0 #3.0))) any_true)
                  (as (agg (fid 12)) rows)
                  (as (agg (fid 13) (lift (= #1.0 #3.0))) known))))
            (or
              (not
                (coalesce
                  (case
                    (when (coalesce #4.0 false) true)
                    (when
                      (coalesce (lift (> #4.1 #4.2)) false)
                      (cast null bool))
                    (else false))
                  true))
              (> #1.4 100)))
          (aggregate :bind 6
            (filter (get (tid 101) :as p :bind 5) (= #5.1 #1.0))
            (keys)
            (aggs (as (agg (fid 50) #5.5) max))))
        (project :bind 8
          (limit (filter (get (tid 102) :as f :bind 7) (= #7.1 #1.0)) :count 1)
          (as true present)))
      (aggregate :bind 11
        (project (get (tid 101) :as q :bind 9) (as #9.3 likes) :bind 10)
        (keys)
        (aggs
          (as (agg (fid 53) (< #1.4 (cast #10.0 int8))) any_true)
          (as (agg (fid 12)) rows)
          (as (agg (fid 13) (< #1.4 (cast #10.0 int8))) known))))
    (as #1.1 name)
    (as #6.0 last_post)
    (as (is-not-null #8.0) followed)
    (as
      (call
        (fid 80)
        (case
          (when (coalesce #11.0 false) true)
          (when (coalesce (lift (> #11.1 #11.2)) false) (cast null bool))
          (else false)))
      top)))
