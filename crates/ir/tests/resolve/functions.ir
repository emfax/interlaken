; Overloads: the fewest implicit conversions win; literals adapt to int4
; parameters; aggregates are named after their function.
(plan
  (aggregate
    (get users :as u)
    (keys (as (call lower u.name) lname) (call substr u.name 1 3))
    (aggs
      (agg count)
      (agg sum u.age)
      (as (agg max u.seen_at) last_seen)
      (as (agg count u.email :distinct true :filter (> u.karma 0)) emails)
      (agg avg (call abs u.karma)))))
;; resolved
(plan :schema-version 7
  (aggregate :bind 2
    (get (tid 100) :as u :bind 1)
    (keys (as (call (fid 1) #1.1) lname) (call (fid 4) #1.1 (int4 1) (int4 3)))
    (aggs
      (as (agg (fid 12)) count)
      (as (agg (fid 25) #1.3) sum)
      (as (agg (fid 50) #1.6) last_seen)
      (as (agg (fid 18) #1.2 :distinct true :filter (> #1.4 0)) emails)
      (as (agg (fid 30) (call (fid 7) #1.4)) avg))))
