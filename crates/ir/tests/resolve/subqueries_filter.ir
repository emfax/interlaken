; Top-level filter conjuncts become semi and anti applies.
(plan
  (filter
    (get users :as u)
    (and
      (exists (filter (get posts :as p) (= p.author_id u.id)))
      (not (exists (filter (get follows :as f) (= f.follower_id u.id))))
      (in u.id (project (get follows :as g) g.followee_id))
      (any > u.karma (project (get posts :as q) q.likes))
      (> u.age 21))))
;; resolved
(plan :schema-version 7
  (filter
    (apply semi
      (apply semi
        (apply anti
          (apply semi
            (get (tid 100) :as u :bind 1)
            (filter (get (tid 101) :as p :bind 2) (= #2.1 #1.0)))
          (filter (get (tid 102) :as f :bind 3) (= #3.0 #1.0)))
        (filter
          (project (get (tid 102) :as g :bind 4) (as #4.1 followee_id) :bind 5)
          (= #1.0 #5.0)))
      (filter
        (project (get (tid 101) :as q :bind 6) (as #6.3 likes) :bind 7)
        (> #1.4 (cast #7.0 int8))))
    (> #1.3 (int4 21))))
