; The fixture catalog every resolver golden test runs against.
(catalog :schema-version 7
  (builtins)
  (table users :id 100
    (column id int8)
    (column name text)
    (column email (option text))
    (column age (option int4))
    (column karma int8)
    (column born (option date))
    (column seen_at (option timestamptz))
    (column tags (option (array text)))
    (primary-key id))
  (table posts :id 101
    (column id int8)
    (column author_id int8)
    (column title text)
    (column likes int4)
    (column score (option float8))
    (column created_at timestamptz)
    (primary-key id))
  (table follows :id 102
    (column follower_id int8)
    (column followee_id int8)
    (primary-key follower_id followee_id))
  (table audit :id 103
    (column id int8)
    (column user_id (option int8))
    (column action text)
    (column level (option int2))
    (primary-key id))
  (table sys_roles :id 1 :system true
    (column id int8)
    (column name text)
    (primary-key id)))
