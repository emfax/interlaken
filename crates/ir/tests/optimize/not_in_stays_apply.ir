; NOT IN must return NULL when the subquery has NULLs, so its lowering aggregates
; over a comparison with the outer row; that apply is not decorrelated.
(plan
  (project
    (filter (get users :as u) (not (in u.id (project (get audit :as a) a.user_id))))
    u.name))
;; optimized
(plan :schema-version 7
  (project :bind 5
    (filter
      (apply single
        (get (tid 100) :as u :bind 1)
        (aggregate :bind 4
          (project (get (tid 103) :as a :bind 2) (as #2.1 user_id) :bind 3)
          (keys)
          (aggs
            (as (agg (fid 53) (= #1.0 #3.0)) any_true)
            (as (agg (fid 12)) rows)
            (as (agg (fid 13) (= #1.0 #3.0)) known))))
      (not
        (case
          (when #4.0 true)
          (when (> #4.1 #4.2) (cast null bool))
          (else false))))
    (as #1.1 name)))
