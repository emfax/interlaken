; Below a policy barrier only leakproof predicates may move: the comparison does,
; LIKE (which can raise errors) stays above it.
(plan
  (project
    (filter
      (policy-filter (get users :as u) (> u.karma 0))
      (and (= u.age 30) (like u.name "a%")))
    u.name))
;; optimized
(plan :schema-version 7
  (project :bind 2
    (filter
      (policy-filter
        (filter
          (get (tid 100) :as u :bind 1)
          (coalesce (lift (= #1.3 (int4 30))) false))
        (> #1.4 0))
      (like #1.1 "a%"))
    (as #1.1 name)))
