; EXISTS used as a value: the left apply of a marker row becomes a left join
; to the distinct correlation keys.
(plan
  (project
    (get users :as u)
    u.name
    (as (exists (filter (get posts :as p) (and (= p.author_id u.id) (> p.likes 3)))) prolific)))
;; optimized
(plan :schema-version 7
  (project :bind 4
    (join left
      (get (tid 100) :as u :bind 1)
      (distinct
        (project :bind 3
          (filter (get (tid 101) :as p :bind 2) (> #2.3 (int4 3)))
          (as true present)
          #2.1))
      (= #3.1 #1.0))
    (as #1.1 name)
    (as (is-not-null #3.0) prolific)))
