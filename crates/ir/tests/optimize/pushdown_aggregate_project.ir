; A filter on a grouping key moves below the aggregate; a filter on a projected
; expression is rewritten in terms of the projection's input.
(plan
  (filter
    (aggregate
      (filter (project (get posts :as p) (as (+ p.likes 1) l1) p.author_id) (> l1 3))
      (keys author_id)
      (aggs (as (agg sum l1) total)))
    (and (= author_id 1) (> total 5))))
;; optimized
(plan :schema-version 7
  (filter
    (aggregate :bind 3
      (project :bind 2
        (filter
          (get (tid 101) :as p :bind 1)
          (and (> (+ #1.3 (int4 1)) (int4 3)) (= #1.1 1)))
        (as (+ #1.3 (int4 1)) l1)
        (as #1.1 author_id))
      (keys (as #2.1 author_id))
      (aggs (as (agg (fid 25) #2.0) total)))
    (coalesce (lift (> #3.1 5)) false)))
